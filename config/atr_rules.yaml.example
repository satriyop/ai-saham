# Example rules file using ATR (Average True Range) plugin indicator
#
# Impacted CLI Commands:
#   - saham analyze risk TICKER (when passed via --rules-file / -r)
#   - saham strategy backtest TICKER (when passed via --rules-file / -r)
#
# This demonstrates how to use plugin indicators in your rules.
# The ATR indicator must be available in plugins/indicators/atr.py
#
# Usage:
#   saham risk BBCA -r config/atr_rules.yaml.example
#   saham backtest BBCA -r config/atr_rules.yaml.example

version: 1
name: "volatility_strategy"
description: "Uses ATR to measure volatility and adjust risk assessment"

default_outcome: MODERATE

# Signal mapping for backtesting (optional)
signal_mapping:
  LOW_RISK: ENTER_LONG
  MODERATE: HOLD
  HIGH_RISK: EXIT_LONG

# Define custom indicator instances
# You can mix built-in indicators (SMA, EMA, RSI) with plugin indicators (ATR)
indicators:
  # Plugin indicator: ATR (Average True Range)
  # Measures market volatility
  atr_14:
    type: ATR        # Plugin indicator name
    period: 14

  # Built-in indicators
  rsi_short:
    type: RSI
    period: 7

  fast_ema:
    type: EMA
    period: 9

  slow_ema:
    type: EMA
    period: 21

# Rules evaluated in priority order (lower = first)
rules:
  # High volatility + overbought = high risk
  - name: "high_volatility_overbought"
    priority: 10
    when:
      indicator: rsi_short
      operator: ">"
      value: 70
    outcome: HIGH_RISK
    rationale: "RSI overbought in volatile market conditions"

  # Low volatility + oversold = opportunity
  - name: "low_volatility_oversold"
    priority: 20
    when:
      indicator: rsi_short
      operator: "<"
      value: 30
    outcome: LOW_RISK
    rationale: "RSI oversold - potential bounce opportunity"

  # Trend following: fast EMA above slow EMA
  - name: "uptrend_confirmation"
    priority: 50
    when:
      left:
        indicator: fast_ema
      operator: ">"
      right:
        indicator: slow_ema
    outcome: LOW_RISK
    rationale: "Fast EMA above slow EMA indicates uptrend"

  # Downtrend: fast EMA below slow EMA
  - name: "downtrend_warning"
    priority: 50
    when:
      left:
        indicator: fast_ema
      operator: "<"
      right:
        indicator: slow_ema
    outcome: HIGH_RISK
    rationale: "Fast EMA below slow EMA indicates downtrend"

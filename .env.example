# AI Saham - Environment Configuration Template
# Copy this file to .env and populate with your personal configuration.
# Never commit your .env file or real API keys.

# ── AI Provider API Keys (Optional) ──────────────────────────────────────────
# Used for AI explanation and catalyst classification features.
# Core analysis and rule engine run 100% deterministically without these.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=

# ── Development & Live Test Harness Flags ────────────────────────────────────
# Hard gate for running live provider integration tests in tests/agent_live/
# 0 = disabled (default), 1 = enabled
AI_SAHAM_AGENT_LIVE=0
AI_SAHAM_LIVE_TICKER=BBCA
AI_SAHAM_LIVE_BROKER=AK
